---
import { money } from '../lib/cart.js';
const { product } = Astro.props;
---
<article class="group flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-forest/10 bg-white transition-shadow hover:shadow-lg">
    <div class="relative overflow-hidden bg-[#edf1e6]">
        <div role="img" aria-label={product.name} class="photo product-photo transition-transform duration-500 group-hover:scale-105" style={`background-image:url('${product.image}');background-position:${product.position || 'center'};`}></div>
        {product.featured && <span class="absolute left-3 top-3 rounded-full bg-cream px-3 py-1 text-xs font-semibold text-forest">Favorito de la casa</span>}
    </div>
    <div class="flex flex-1 flex-col p-4 sm:p-5">
        <p class="eyebrow !text-[10px] text-forest/65">{product.category}</p>
        <h3 class="mt-2 text-xl sm:text-2xl">{product.name}</h3>
        <p class="mt-2 text-sm text-stone-600">{product.description}</p>
        <p class="mt-2 text-xs text-stone-500">{product.size}</p>
        <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-5">
            <span class="text-lg font-semibold text-forest">{money(product.price)}</span>
            <button type="button" data-add={product.id} aria-label={`Agregar ${product.name} al carrito`} class="rounded-full bg-forest px-4 py-2.5 text-sm text-white transition-colors hover:bg-[#123e2e]">Agregar <span aria-hidden="true">+</span></button>
        </div>
    </div>
</article>
<style>
    .product-photo { aspect-ratio: 1.2; background-size: 530%; }
</style>
