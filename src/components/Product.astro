---
const { product } = Astro.props;

const {
    name,
    description,
    size,
    price,
    category,
    brand,
    image,
    position,
    featured,
    href,
} = product;

const formattedPrice =
    typeof price === "number"
        ? new Intl.NumberFormat("es-PE", {
              style: "currency",
              currency: "PEN",
          }).format(price)
        : null;
---

<article
    class="group grid h-full min-h-[170px] min-w-0 grid-cols-[40%_minmax(0,1fr)] overflow-hidden rounded-2xl border border-forest/10 bg-white transition-all duration-300 hover:-translate-y-0.5 hover:border-forest/20 hover:shadow-[0_12px_30px_rgba(30,65,40,0.07)]"
>
    <!-- IMAGEN -->
    <div class="relative min-h-full overflow-hidden bg-[#edf1e6]">
        {
            image ? (
                <img
                    src={image}
                    alt={name}
                    loading="lazy"
                    style={`object-position: ${position || "center"};`}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
            ) : (
                <div class="flex h-full items-center justify-center p-3 text-center font-serif text-lg text-forest/50">
                    Ados Sweet
                </div>
            )
        }

        {
            featured && (
                <span class="absolute left-2 top-2 rounded-full bg-coral px-2.5 py-1 text-[9px] font-semibold text-white shadow-sm">
                    Destacado
                </span>
            )
        }
    </div>

    <!-- INFORMACIÓN -->
    <div class="flex min-w-0 flex-col p-3 sm:p-4">
        <!-- CATEGORÍA -->
        {
            category && (
                <div class="mb-2">
                    <span class="inline-flex rounded-full bg-[#edf1e6] px-2.5 py-1 text-[10px] font-medium text-forest">
                        {category}
                    </span>
                </div>
            )
        }

        <!-- NOMBRE -->
        <h3
            class="line-clamp-2 font-serif text-base font-semibold leading-tight text-forest transition-colors group-hover:text-coral sm:text-lg"
        >
            {name}
        </h3>

        <!-- DESCRIPCIÓN -->
        {
            description && (
                <p class="mt-1 line-clamp-1 text-xs leading-5 text-stone-500">
                    {description}
                </p>
            )
        }

        <!-- PRESENTACIÓN -->
        {size && <p class="mt-1 text-[11px] text-stone-400">{size}</p>}

        <!-- PRECIO Y BOTÓN -->
        <div
            class="mt-auto flex items-center justify-between gap-2 border-t border-forest/10 pt-3"
        >
            <div class="min-w-0">
                <p class="text-[10px] text-stone-400">Precio</p>

                <p
                    class="text-base font-bold tracking-tight text-forest sm:text-lg"
                >
                    {formattedPrice ?? "Consultar"}
                </p>
            </div>

            {
                href && (
                    <a
                        href={href}
                        aria-label={`Ver detalles de ${name}`}
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-forest text-white transition-all duration-300 hover:-rotate-45 hover:bg-coral"
                    >
                        <svg
                            class="h-4 w-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            aria-hidden="true"
                        >
                            <path
                                d="M5 19 19 5M7 5h12v12"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </a>
                )
            }
        </div>
    </div>
</article>
