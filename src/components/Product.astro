---
import { money } from '../lib/cart.js';
import { catalog } from '../data/products.js';
const { product } = Astro.props;
const variants = product.variants || catalog.find(item => item.id === (product.catalogId || product.id))?.variants || [product];
const available = product.available !== false;
---
<article data-product-card data-product-name={product.name} class="group flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-forest/10 bg-white transition-shadow hover:shadow-lg">
    <div class="relative overflow-hidden bg-[#edf1e6]">
        <img data-product-image src={product.image} alt={product.name} loading="lazy" width="600" height="500" class="product-photo w-full object-contain p-4 transition-transform duration-500 group-hover:scale-105" />
        {!available ? <span class="absolute left-3 top-3 rounded-full bg-white px-3 py-1 text-xs font-semibold text-stone-600">Fuera de stock</span> : product.featured && <span class="absolute left-3 top-3 rounded-full bg-cream px-3 py-1 text-xs font-semibold text-forest">Favorito de la casa</span>}
    </div>
    <div class="flex flex-1 flex-col p-4 sm:p-5">
        <p class="eyebrow !text-[10px] text-forest/65">{product.category}{product.line && ` · ${product.line}`}</p>
        <h3 class="mt-2 text-xl sm:text-2xl">{product.name}</h3>
        <p class="mt-2 text-sm text-stone-600">{product.description}</p>
        {product.adultsOnly && <p class="mt-2 text-xs font-semibold text-forest">Contiene licor · Solo para adultos</p>}
        <div class="mt-auto pt-4">
            {variants.length > 1 ? <label class="block text-xs text-stone-500">Presentación
                <select data-product-variant aria-label={`Presentación de ${product.name}`} class="mt-1 w-full rounded-lg border border-forest/20 bg-white px-2 py-2 text-sm text-forest">
                    {variants.map(variant => <option value={variant.id} selected={variant.id === product.id} data-price={variant.price} data-image={variant.image} data-size={variant.size}>{variant.size} · {money(variant.price)}</option>)}
                </select>
            </label> : <p class="text-xs text-stone-500">{product.size}</p>}
            <div class="flex flex-wrap items-center justify-between gap-3 pt-4">
                <span data-product-price class="text-lg font-semibold text-forest" aria-live="polite">{money(product.price)}</span>
                <button type="button" data-add={product.id} disabled={!available} aria-label={available ? `Agregar ${product.name} (${product.size}) al carrito` : `${product.name} fuera de stock`} class="rounded-full bg-forest px-4 py-2.5 text-sm text-white transition-colors hover:bg-[#123e2e] disabled:cursor-not-allowed disabled:bg-stone-200 disabled:text-stone-500">{available ? 'Agregar +' : 'Agotado'}</button>
            </div>
        </div>
    </div>
</article>
<style>
    .product-photo { aspect-ratio: 1.2; height: auto; }
</style>
<script>
    import { money } from '../lib/cart.js';
    document.addEventListener('change', (event) => {
        const select = event.target;
        if (!(select instanceof HTMLSelectElement) || !select.matches('[data-product-variant]')) return;
        const card = select.closest<HTMLElement>('[data-product-card]');
        const option = select.selectedOptions[0];
        if (!card || !option) return;
        const price = Number(option.dataset.price);
        card.querySelector('[data-product-price]')!.textContent = money(price);
        const image = card.querySelector<HTMLImageElement>('[data-product-image]')!;
        image.src = option.dataset.image!;
        const button = card.querySelector<HTMLButtonElement>('[data-add]')!;
        button.dataset.add = option.value;
        button.setAttribute('aria-label', `Agregar ${card.dataset.productName} (${option.dataset.size}) al carrito`);
        const item = card.closest<HTMLElement>('.shop-product');
        if (item) {
            item.dataset.price = String(price);
            document.querySelector('#shop-sort')?.dispatchEvent(new Event('change'));
        }
    });
</script>
