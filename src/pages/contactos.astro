---
import Layout from "../layouts/Layout.astro";

const redes = [
    {
        nombre: "Instagram",
        usuario: "@adossweet",
        url: "https://www.instagram.com/adossweet/",
        descripcion: "Explora nuestras publicaciones y envíanos un mensaje.",
    },
    {
        nombre: "Facebook",
        usuario: "Ados Sweet",
        url: "https://www.facebook.com/ADOSMERMELADAS/",
        descripcion:
            "Conoce nuestra propuesta y ponte en contacto con nosotros.",
    },
    {
        nombre: "TikTok",
        usuario: "@adossweet",
        url: "https://www.tiktok.com/@adossweet",
        descripcion: "Descubre más contenido de nuestra marca.",
    },
];
---

<Layout title="Contactos · Conversemos | Ados Sweet">
    <section
        class="wrap grid items-start gap-12 py-12 lg:grid-cols-[.9fr_1.1fr]"
    >
        <div>
            <p class="eyebrow mb-5">Estamos para escucharte</p>

            <h1>
                Conversemos<br />
                de algo <em class="text-coral">rico.</em>
            </h1>

            <p class="mt-6 max-w-lg text-stone-600">
                ¿Quieres conocer más sobre nuestros productos o sobre Antojitos
                Dulces By Rosa? Encuéntranos en nuestras redes y cuéntanos qué
                estás buscando.
            </p>

            <div class="mt-8 border-t border-forest/15 pt-6">
                <p class="eyebrow mb-2">Ubicación</p>
                <p class="serif text-2xl">Lima, Perú</p>
            </div>
        </div>

        <div class="space-y-5">
            {
                redes.map((red) => (
                    <a
                        href={red.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group block rounded-2xl border border-forest/15 bg-white/60 p-7 transition-colors hover:bg-[#edf1e6]"
                        aria-label={`${red.nombre}: ${red.usuario}. Abre en otra pestaña`}
                    >
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="eyebrow mb-3">{red.nombre}</p>
                                <h2 class="text-3xl">{red.usuario}</h2>
                            </div>

                            <span
                                aria-hidden="true"
                                class="text-2xl transition-transform group-hover:-translate-y-1 group-hover:translate-x-1"
                            >
                                ↗
                            </span>
                        </div>

                        <p class="mt-4 text-stone-600">{red.descripcion}</p>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>
