---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Blog · Historias de Ados Sweet">
    <section class="wrap py-12">
        <p class="eyebrow mb-5">Nuestro blog</p>

        <h1>
            Un espacio para<br />
            compartir <em class="text-coral">lo que hacemos.</em>
        </h1>

        <div
            class="mt-10 max-w-3xl rounded-3xl border border-forest/15 bg-white/60 p-8 md:p-12"
        >
            <h2 class="text-3xl">
                Estamos preparando nuestras primeras publicaciones.
            </h2>

            <p class="mt-5 text-stone-600">
                Mientras tanto, puedes conocer la historia de Ados Sweet,
                nuestra filosofía y las propuestas que nacen de nuestra casa.
            </p>

            <div class="mt-7 flex flex-wrap gap-4">
                <a href="/nosotros/" class="btn"> Conoce nuestra historia ↗ </a>

                <a
                    href="/contactos/"
                    class="inline-flex items-center rounded-full border border-forest/30 px-6 py-3 text-sm"
                >
                    Encuéntranos en redes
                </a>
            </div>
        </div>
    </section>
</Layout>
