---
import Layout from "../layouts/Layout.astro";
import Product from "../components/Product.astro";
import { products } from "../data/products.js";

const propuestas = [
    {
        numero: "01",
        nombre: "Ados Sweet",
        descripcion:
            "Alimentos artesanales y funcionales pensados para disfrutar y cuidar de ti. Desarrollamos productos para personas y familias que buscan opciones diferentes, procurando equilibrar innovación, calidad y sabor.",
        enlace: "/nosotros/",
        boton: "Conoce Ados Sweet",
    },
    {
        numero: "02",
        nombre: "Antojitos Dulces By Rosa",
        descripcion:
            "Una propuesta de repostería tradicional artesanal, elaborada con dedicación y ese sabor de siempre que nos conecta con nuestros recuerdos, nuestras familias y las personas que queremos.",
        enlace: "/nosotros/#antojitos",
        boton: "Conoce Antojitos Dulces",
    },
];
---

<Layout title="Ados Sweet · Alimentos artesanales y funcionales">
    <!-- HERO -->
    <section class="wrap grid items-center gap-10 lg:grid-cols-[.9fr_1.1fr]">
        <div>
            <p class="eyebrow mb-6 text-forest">
                Dos propuestas. Una misma casa.
            </p>

            <h1>
                Disfrutar algo rico<br />
                y cuidarte <em class="text-coral">pueden ir juntos.</em>
            </h1>

            <p class="mt-6 max-w-lg text-stone-600">
                Creemos que disfrutar de algo rico y cuidar de nuestra
                alimentación no tienen por qué ser caminos separados.
            </p>

            <p class="mt-4 max-w-lg text-stone-600">
                Por eso creamos alimentos artesanales para personas y familias
                que buscan opciones diferentes, con ingredientes reconocibles y
                formulaciones desarrolladas con propósito.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-6">
                <a href="/tienda/" class="btn">
                    Explorar la tienda
                    <span aria-hidden="true">↗</span>
                </a>

                <a
                    href="#propuestas"
                    class="border-b border-forest pb-1 text-sm"
                >
                    Conoce nuestras propuestas
                </a>
            </div>
        </div>

        <div class="relative pb-6">
            <img
                src="/images/ados-sweet.png"
                alt="Productos artesanales y funcionales de Ados Sweet"
                class="aspect-[1] h-[530px] w-full rounded-b-3xl rounded-t-[160px] object-cover"
                fetchpriority="high"
            />
        </div>
    </section>

    <!-- CARACTERÍSTICAS -->
    <div class="mt-10 border-y border-forest/15">
        <div
            class="wrap grid grid-cols-2 gap-5 py-6 text-center text-sm md:grid-cols-4"
        >
            <span>Elaboración artesanal</span>
            <span>Ingredientes reconocibles</span>
            <span>Formulaciones con propósito</span>
            <span>Calidad y sabor</span>
        </div>
    </div>

    <!-- DOS PROPUESTAS -->
    <section id="propuestas" class="wrap scroll-mt-8 py-16">
        <div class="mb-10 max-w-2xl">
            <p class="eyebrow mb-4">Elige cómo quieres disfrutarlo</p>

            <h2>
                Una misma casa.<br />
                Dos maneras de disfrutar.
            </h2>

            <p class="mt-5 text-stone-600">
                Ados Sweet y Antojitos Dulces By Rosa nacen de una misma pasión
                por crear alimentos hechos con dedicación, honestidad y respeto
                por las personas que los llevan a su mesa.
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            {
                propuestas.map((propuesta, index) => (
                    <article
                        class:list={[
                            "flex flex-col rounded-3xl border border-forest/10 p-8 md:p-10",
                            index === 0 ? "bg-[#edf1e6]" : "bg-[#f9e8df]",
                        ]}
                    >
                        <span class="eyebrow text-forest/70">
                            Propuesta {propuesta.numero}
                        </span>

                        <h3 class="mt-5 text-3xl md:text-4xl">
                            {propuesta.nombre}
                        </h3>

                        <p class="mb-7 mt-5 leading-7 text-stone-700">
                            {propuesta.descripcion}
                        </p>

                        <a
                            href={propuesta.enlace}
                            class="mt-auto self-start border-b border-forest pb-1 text-sm"
                        >
                            {propuesta.boton} ↗
                        </a>
                    </article>
                ))
            }
        </div>
    </section>

    <!-- ADOS SWEET -->
    <section
        class="wrap grid items-center gap-8 rounded-3xl bg-[#eee8d7] p-8 md:grid-cols-2 md:p-14"
    >
        <div>
            <p class="eyebrow mb-5">Nuestra propuesta</p>

            <h2>
                Ciencia, calidad<br />
                y placer.
            </h2>
        </div>

        <div>
            <p>
                Ados Sweet nace desde la innovación y el compromiso con la
                alimentación funcional. Desarrollamos productos pensando en
                quienes tienen distintas necesidades o restricciones
                alimentarias, sin dejar de lado el sabor.
            </p>

            <p class="mt-4">
                Nuestra búsqueda está en encontrar un equilibrio entre
                ingredientes, calidad, innovación y placer para ofrecer
                alternativas que puedan formar parte de distintos estilos de
                alimentación.
            </p>

            <a
                href="/nosotros/#filosofia"
                class="mt-6 inline-block border-b border-forest pb-1 text-sm"
            >
                Conoce nuestra filosofía ↗
            </a>
        </div>
    </section>

    <!-- PRODUCTOS -->
    <section class="wrap py-16">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-6">
            <div>
                <p class="eyebrow mb-3">Algo rico para cada momento</p>

                <h2>Descubre nuestros productos.</h2>

                <p class="mt-4 max-w-xl text-stone-600">
                    Conoce algunas de las alternativas artesanales que
                    desarrollamos para disfrutar diferentes momentos del día.
                </p>
            </div>

            <a href="/tienda/" class="border-b border-forest pb-1 text-sm">
                Explorar el catálogo ↗
            </a>
        </div>
    </section>

    <!-- MENSAJE DE MARCA -->
    <section class="wrap pb-16">
        <div
            class="rounded-[32px] bg-[#f9e8df]
                   px-7 py-12 text-center
                   sm:px-10 md:py-16"
        >
            <p class="eyebrow mb-4">Lo que nos une</p>

            <h2 class="mx-auto max-w-3xl">
                Una misma pasión.<br />
                Un mismo compromiso.
            </h2>

            <p
                class="mx-auto mt-6 max-w-2xl
                       leading-7 text-stone-600"
            >
                Ados Sweet y Antojitos Dulces By Rosa comparten una misma forma
                de entender lo que hacemos: crear alimentos con dedicación,
                honestidad y respeto por las personas.
            </p>

            <a
                href="/nosotros/"
                class="mt-7 inline-block border-b border-forest pb-1 text-sm"
            >
                Conoce nuestra historia ↗
            </a>
        </div>
    </section>
</Layout>
